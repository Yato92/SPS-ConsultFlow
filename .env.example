# ==== Общие настройки ====
ENVIRONMENT=development
SECRET_KEY=consultflow-dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
MAGIC_LINK_EXPIRE_MINUTES=15

# ==== Production VPS (docker-compose.prod.yml) ====
# DOMAIN=consultflow.example.ru
# POSTGRES_PASSWORD=change-me
# ADMIN_PASSWORD=change-me
# BOT_API_TOKEN=change-me
# Подробнее: docs/deploy-regru.md

# ==== База данных ====
# SQLite (по умолчанию, ничего устанавливать не нужно):
DATABASE_URL=sqlite:///./consultflow.db
# PostgreSQL (docker-compose):
# DATABASE_URL=postgresql+psycopg://consultflow:consultflow@localhost:5432/consultflow
# Внешняя PostgreSQL на reg.ru / втором сервере:
# DATABASE_URL=postgresql+psycopg://user:password@db.example.ru:5432/consultflow?sslmode=require
# MySQL 5.7 на виртуальном хостинге reg.ru (только MySQL 5.7, не 8):
# DATABASE_URL=mysql+pymysql://u1234567_user:password@serverX.hosting.reg.ru:3306/u1234567_consultflow?charset=utf8mb4
# Пароль в URL кодируется: @ → %40, : → %3A, / → %2F, # → %23.

# ==== API ====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
FRONTEND_URL=http://localhost:5173
SEED_DEMO=true
# Публичный учебный API /api/prototype (не включать на реальных данных)
PROTOTYPE_DEMO=true
# Ссылка на прототип в меню Telegram-бота
PROTOTYPE_URL=http://127.0.0.1:5173/prototype/

# ==== Telegram ====
BOT_TOKEN=123456:PUT-YOUR-BOTFATHER-TOKEN-HERE
BOT_API_TOKEN=dev-bot-token-change-me
# Если Telegram недоступен напрямую — HTTP/SOCKS-прокси для бота:
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
TELEGRAM_PROXY=
# Telegram ID руководителей/менеджеров через запятую — они получат роль manager в боте
MANAGER_TELEGRAM_IDS=
BACKEND_URL=http://127.0.0.1:8000

# ==== ВКонтакте ====
# ID сообщества (только цифры) и токен из настроек сообщества → API
VK_GROUP_ID=
VK_TOKEN=

# ==== Демо-доступ в дашборд ====
ADMIN_EMAIL=admin@consultflow.ru
ADMIN_PASSWORD=admin12345

# ==== ИИ-консультант (Polza.ai) ====
# Ключ создаётся в https://polza.ai/dashboard/api-keys
AI_ENABLED=true
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
AI_MODEL=deepseek/deepseek-v4.1-flash-1017
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1200
AI_TIMEOUT=90
AI_HISTORY_LIMIT=12
# Дополнительные правила для ИИ (необязательно)
AI_EXTRA_PROMPT=
