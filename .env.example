# ==== Общие настройки ====
ENVIRONMENT=development
SECRET_KEY=consultflow-dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
MAGIC_LINK_EXPIRE_MINUTES=15

# ==== База данных ====
# SQLite (по умолчанию, ничего устанавливать не нужно):
DATABASE_URL=sqlite:///./consultflow.db
# PostgreSQL (docker-compose):
# DATABASE_URL=postgresql+psycopg://consultflow:consultflow@localhost:5432/consultflow

# ==== API ====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8050
FRONTEND_URL=http://localhost:5173
SEED_DEMO=true

# ==== Telegram ====
BOT_TOKEN=123456:PUT-YOUR-BOTFATHER-TOKEN-HERE
BOT_API_TOKEN=dev-bot-token-change-me
# Telegram ID руководителей/менеджеров через запятую — они получат роль manager в боте
MANAGER_TELEGRAM_IDS=
BACKEND_URL=http://127.0.0.1:8000

# ==== Демо-доступ в дашборд ====
ADMIN_EMAIL=admin@consultflow.ru
ADMIN_PASSWORD=admin12345
